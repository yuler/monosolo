!core/tmp/.keep
# Ignore pidfiles, but keep the directory.
core/tmp/pids/*
!core/tmp/pids/
!core/tmp/pids/.keep
# Ignore storage (uploaded files in development and any SQLite databases).
core/storage/*
!core/storage/.keep
core/tmp/storage/*
!core/tmp/storage/
!core/tmp/storage/.keep
core/public/assets
core/config/*.key
core/app/assets/builds/*
!core/app/assets/builds/.keep

