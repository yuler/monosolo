# ===========================================================================
# MonoSolo — Dokploy Production Environment Template (Mode B)
# ===========================================================================
# Paste into the Dokploy Compose service → Environment tab.
# Dokploy writes this to `.env` next to compose.dokploy.yml on the host server.
# Do NOT copy a local `mise` `.env` (which is configured for Mode A multi-domain).

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
# Public hostname only (no scheme or port). Must match the Dokploy domain on `web`.
SITE_DOMAIN=monosolo.example.com
SITE_NAME=MonoSolo

# Passkeys (WebAuthn) — optional until Milestone 6.
# When configured: RP ID = registrable domain (no scheme/port). Origins = comma-separated (with scheme).
# WEBAUTHN_RP_ID=monosolo.example.com
# WEBAUTHN_ALLOWED_ORIGINS=https://monosolo.example.com

# Image tag: pin to a release tag (e.g. v0.1.0) or leave `main` for CD.
# Note: Builds are path-filtered, so per-commit `sha-<short>` tags only exist for
# services touched by that commit. Do not pin both images to a per-commit SHA
# unless both core and web were published for that SHA.
IMAGE_TAG=main

# -----------------------------------------------------------------------------
# Core (Rails)
# -----------------------------------------------------------------------------
# Generate with: cd core && bin/rails secret
SECRET_KEY_BASE=

# Only if you use encrypted Rails credentials:
# RAILS_MASTER_KEY=

# Solid Queue worker concurrency (defaults to CPU count; production servers are often memory-tight).
JOB_CONCURRENCY=1

# SQLite database paths relative to /rails working directory in container
DB_NAME=storage/production.sqlite3
DB_NAME_CACHE=storage/production_cache.sqlite3
DB_NAME_QUEUE=storage/production_queue.sqlite3
DB_NAME_CABLE=storage/production_cable.sqlite3

# SMTP Outbound Email
SMTP_ADDRESS=
SMTP_DOMAIN=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL_ENABLED=true
EMAIL_SENDER=noreply@monosolo.example.com

# -----------------------------------------------------------------------------
# Web (apps/web)
# -----------------------------------------------------------------------------
# Image build already bakes VITE_CORE_URL empty (same-origin /api).
# Runtime proxy is handled by compose.dokploy.yml (CORE_INTERNAL_URL=http://core:80).

# -----------------------------------------------------------------------------
# Mode B Forbidden Variables (DO NOT SET HERE)
# -----------------------------------------------------------------------------
# - SESSION_COOKIE_DOMAIN: Must be empty/unset for Host-only cookies in Mode B.
#   Setting this to a parent domain breaks authentication across reverse proxy.
# - SOLID_QUEUE_IN_PUMA: Must remain "false" (forced in compose.dokploy.yml)
#   so the dedicated `worker` service handles background jobs instead of Puma.
# - VITE_CORE_URL: Must remain empty in production image builds.
# - CORE_PORT / WEB_PORT: Local development Mode A ports only; do not set here.
