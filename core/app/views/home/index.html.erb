<div class="min-h-screen flex items-center justify-center bg-base-100">
  <div class="text-center px-6">
    <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent">
      Welcome
    </h1>
    <p class="text-xl text-base-content/70 mb-8 max-w-lg mx-auto">
      Your new Rails application is ready. Start building something amazing.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Get Started", sign_in_path, class: "btn btn-primary btn-lg" %>
      <a href="https://github.com" target="_blank" class="btn btn-outline btn-lg">View on GitHub</a>
    </div>
  </div>
</div>
