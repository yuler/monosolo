<header id="header" class="header">
  <a href="#main" class="header__skip-navigation btn btn--small" data-turbo="false">Skip to main content</a>

  <div class="header__bar">
    <div class="header__logo">
      <%= link_to (current_page?(root_path) ? home_index_path : root_path) do %>
        <%= image_tag 'logo.png', alt: 'monosolo' %>
      <% end %>
    </div>

    <div class="header__actions">
      <button type="button"
              class="theme-toggle"
              data-controller="theme"
              data-action="theme#toggle"
              aria-label="Toggle color theme">
        <svg data-theme-target="light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg data-theme-target="dark" hidden xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <% if current_page?(home_index_path) %>
        <div class="header__actions">
          <a href="#features" class="btn btn--ghost btn--small">Features</a>
          <a href="#pricing" class="btn btn--ghost btn--small">Pricing</a>
        </div>
      <% end %>

      <% if Current.identity %>
        <!-- User Avatar Menu -->
        <div class="menu">
          <button type="button" class="menu__trigger" aria-label="Account menu">
            <span><%= Current.identity.full_name.first.upcase %></span>
          </button>
          <div class="menu__content">
            <div class="menu__title"><%= Current.identity.email %></div>
            <%= link_to my_accounts_path, class: "menu__item #{'is-active' if current_page?(my_accounts_path)}" do %>
              <%= image_tag 'users.svg', alt: '' %>
              <span>My Accounts</span>
            <% end %>
            <%= button_to sign_out_path, method: :delete, class: "menu__item", data: { turbo: false } do %>
              <%= image_tag 'log-out.svg', alt: '' %>
              <span>Sign Out</span>
            <% end %>
          </div>
        </div>
      <% elsif !current_page?(sign_in_path) %>
        <div class="header__actions">
          <%= link_to sign_in_path, class: "btn btn--primary" do %>
            Sign In
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= yield :header %>
</header>
