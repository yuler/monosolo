# Core (Rails) — http://core.monosolo.localhost:3001 (also http://localhost:3001)
CORE_PORT=3001

# apps/web (Vite) — http://web.monosolo.localhost:3000 (also http://localhost:3000)
WEB_PORT=3000

# Base URL of the Rails core, exposed to the Vite browser bundle.
# Subdomain split (A): http://core.monosolo.localhost:3001
# Same-origin proxy (B): leave empty so apps/web calls relative /api/v1 paths.
VITE_CORE_URL=http://core.monosolo.localhost:3001

# Shared session cookie domain for subdomain split (A), e.g. .monosolo.localhost or .example.com
# Leave unset for same-origin proxy (B) — cookies stay host-only on the web app origin.
# SESSION_COOKIE_DOMAIN=.monosolo.localhost
