# Core: http://core.monosolo.localhost:${CORE_PORT}
CORE_PORT=3001
# Web:  http://web.monosolo.localhost:${WEB_PORT}
WEB_PORT=3000

# Shared cookie Domain for Mode A (web.* + core.*). Leave unset for Mode B (proxy).
SESSION_COOKIE_DOMAIN=.monosolo.localhost

# Browser-facing (Vite). Prefer ${…} aliases so ports stay single-sourced.
# Mode B: set VITE_CORE_URL= (empty) for same-origin /api/v1.
VITE_CORE_URL=http://core.monosolo.localhost:${CORE_PORT}
